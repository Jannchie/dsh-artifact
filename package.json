{
  "name": "dsh-artifact",
  "version": "0.5.0",
  "description": "Claude-Code-style artifacts for dsh: an `artifact` tool that writes self-contained HTML, a bundled authoring skill, a sidebar nav button, and an in-app artifact browser with sandboxed HTML preview",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "artifact",
    "html",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/dsh-artifact.git"
  },
  "homepage": "https://github.com/Jannchie/dsh-artifact#readme",
  "bugs": "https://github.com/Jannchie/dsh-artifact/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/store.js",
    "cordis.patch.yml",
    "README.zh.md",
    "NOTES.md"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
